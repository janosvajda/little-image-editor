{
  "name": "little-image-editor",
  "displayName": "Little Image Editor",
  "description": "Edit images and layered SVG documents inside VS Code.",
  "icon": "webview/assets/images/extensionIcon-128.png",
  "version": "0.3.33",
  "publisher": "janosvajda",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/janosvajda/little-image-editor.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "littleImageEditor.image",
        "displayName": "Little Image Editor",
        "selector": [
          {
            "filenamePattern": "*.png"
          },
          {
            "filenamePattern": "*.jpg"
          },
          {
            "filenamePattern": "*.jpeg"
          },
          {
            "filenamePattern": "*.webp"
          },
          {
            "filenamePattern": "*.svg"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "littleImageEditor.newImage",
        "title": "New Image – Little Image Editor",
        "icon": "$(file-media)"
      }
    ],
    "configuration": {
      "title": "Little Image Editor",
      "properties": {
        "littleImageEditor.assistantBridge.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Lets an MCP server that you run yourself reach the images open in this window, on this computer only. The extension does not include an MCP server; see the MCP server guide in the project documentation."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "littleImageEditor.newImage",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ]
    }
  }
}
